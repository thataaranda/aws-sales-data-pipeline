{
  "Comment": "Valida las ventas en S3 y ejecuta el resumen en AWS Glue",
  "StartAt": "Validar CSV en S3",
  "States": {
    "Validar CSV en S3": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:020719520182:function:portfolio-validate-sales",
        "Payload": {}
      },
      "ResultPath": "$.validacion",
      "Next": "Generar resumen con Glue"
    },
    "Generar resumen con Glue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "portfolio-resumen-ventas"
      },
      "ResultPath": "$.glue",
      "End": true
    }
  }
}
